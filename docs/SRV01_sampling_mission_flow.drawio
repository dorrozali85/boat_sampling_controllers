             fontSize=16;fontStyle=1;"
      vertex="1" parent="1">
      <mxGeometry x="80" y="10" width="560" height="30" as="geometry" />
    </mxCell>

    <!-- IDLE -->
    <mxCell id="3"
      value="&lt;b&gt;IDLE / READY&lt;/b&gt;&lt;br&gt;Waiting for :M1 from ESP32"
