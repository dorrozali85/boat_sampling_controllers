      vertex="1" parent="1">
      <mxGeometry x="155" y="55" width="330" height="60" as="geometry" />
    </mxCell>

    <!-- DECISION: bottles full? -->
    <mxCell id="4"
      value="&lt;b&gt;Bottles full?&lt;/b&gt;"
