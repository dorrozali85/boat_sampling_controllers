             entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
      edge="1" source="5" target="3" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="580" y="130" />
          <mxPoint x="495" y="130" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- ACTION 1: Move turntable to home -->
    <mxCell id="6"
      value="Move turntable to home (waste port)"
