      edge="1" source="4" target="5" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- :FULL → IDLE (dashed loop back) -->
    <mxCell id="e2b"
      style="edgeStyle=orthogonalEdgeStyle;dashed=1;
