          <mxGeometry x="175" y="1460" width="250" height="75" as="geometry"/>
        </mxCell>

        <!-- trigger stuck -->
        <mxCell id="21" value="stuckDetected = true&#xa;setTurnDirection(switchHit)&#xa;lastDebounceTime = millis()" vertex="1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;">
          <mxGeometry x="520" y="1470" width="220" height="55" as="geometry"/>
        </mxCell>

        <!-- sample_interval elapsed? -->
        <mxCell id="22" value="millis() - sampleStart&#xa;&gt;= sample_interval_ms?" vertex="1" parent="1"
          style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;">
          <mxGeometry x="175" y="1590" width="250" height="70" as="geometry"/>
        </mxCell>

        <!-- sampling = true -->
        <mxCell id="23" value="sampling = true" vertex="1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;">
          <mxGeometry x="520" y="1600" width="180" height="50" as="geometry"/>
        </mxCell>

        <!-- Back to top label -->
        <mxCell id="24" value="↩ back to loop() top" vertex="1" parent="1"
