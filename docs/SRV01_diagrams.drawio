        <!-- Step 4 -->
        <mxCell id="76" value="stuckStep == 4&#xa;─────────────&#xa;Wait currentTurnDuration ms&#xa;→ stopCar()&#xa;stuckStep = 5" vertex="1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;">
          <mxGeometry x="960" y="665" width="220" height="100" as="geometry"/>
        </mxCell>

        <!-- Step 5 -->
        <mxCell id="77" value="stuckStep == 5&#xa;─────────────&#xa;Wait STUCK_FINAL_STOP_TIME (400 ms)&#xa;→ stuckDetected = false&#xa;   stuckStep = 0&#xa;   forwardLockStart = millis()&#xa;   &quot;Stuck ended&quot; — resume FORWARD" vertex="1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;">
          <mxGeometry x="960" y="785" width="220" height="130" as="geometry"/>
        </mxCell>

        <!-- Turn direction logic -->
        <mxCell id="78" value="setTurnDirection(switchHit)&#xa;────────────────────────&#xa;Left switch  (1) → turn RIGHT&#xa;Right switch (5) → turn LEFT&#xa;Front switch (3) → random L/R" vertex="1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;">
          <mxGeometry x="1220" y="535" width="230" height="110" as="geometry"/>
        </mxCell>

        <!-- Timing parameters reference -->
        <mxCell id="79" value="Default Timing Parameters&#xa;(all tunable via GUI)&#xa;────────────────────────────&#xa;STUCK_STOP_TIME_1   :  400 ms&#xa;STUCK_REVERSE_TIME  : 2000 ms&#xa;STUCK_STOP_TIME_2   :  400 ms&#xa;min_turn_ms         : 3000 ms&#xa;max_turn_ms         : 6000 ms&#xa;STUCK_FINAL_STOP_TIME: 400 ms&#xa;forward_lock_ms     : 2000 ms" vertex="1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;align=left;">
          <mxGeometry x="1220" y="175" width="230" height="220" as="geometry"/>
        </mxCell>

        <!-- Stuck FSM edges (vertical chain) -->
