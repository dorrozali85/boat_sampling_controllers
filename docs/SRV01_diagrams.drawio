          <mxGeometry x="175" y="815" width="250" height="70" as="geometry"/>
        </mxCell>

        <!-- stopCar (before sampling) -->
        <mxCell id="14" value="stopCar()&#xa;(hold position during sample)" vertex="1" parent="1"
