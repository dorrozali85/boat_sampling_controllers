        <!-- UART arrow ESP32 ↔ Arduino -->
        <mxCell id="14" value="UART Serial2 · 115200 baud&#xa;Commands: :M1 :P0…:P5 :D1 :SD :FT :BT&#xa;Acks: :X1 (done) / :FULL (memory full)"
