          <mxGeometry x="175" y="1030" width="250" height="70" as="geometry"/>
        </mxCell>

        <!-- performAutoSample (blocking) -->
        <mxCell id="16" value="performAutoSample()&#xa;BLOCKING — owns Serial2&#xa;200s timeout&#xa;(see Page 3 for detail)" vertex="1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;">
          <mxGeometry x="520" y="1020" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- Simulated sample (non-blocking) -->
        <mxCell id="17" value="Simulated sample&#xa;(non-blocking delay)&#xa;skipSampleDelay ms&#xa;→ sample_count++" vertex="1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;">
          <mxGeometry x="520" y="1130" width="220" height="90" as="geometry"/>
        </mxCell>

        <!-- moveForwardAutonomous -->
        <mxCell id="18" value="moveForwardAutonomous()&#xa;(both motors forward)" vertex="1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;">
          <mxGeometry x="175" y="1260" width="250" height="55" as="geometry"/>
        </mxCell>

        <!-- checkSwitches -->
        <mxCell id="19" value="checkSwitches()&#xa;(debounced: L=1, F=3, R=5)" vertex="1" parent="1"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;">
          <mxGeometry x="175" y="1360" width="250" height="55" as="geometry"/>
        </mxCell>

        <!-- switchHit AND past fwdLock? -->
        <mxCell id="20" value="switchHit &gt; 0 AND&#xa;past forward_lock_ms?" vertex="1" parent="1"
