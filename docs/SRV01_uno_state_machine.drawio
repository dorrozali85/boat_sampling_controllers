    <!-- STATE_FLUSH -->
    <mxCell id="s_flush"
      value="&lt;b&gt;STATE_FLUSH&lt;/b&gt;&lt;br&gt;
             Run pump (flush mode) for configured flush time&lt;br&gt;
             Soft-start ramp; discharges to waste port (pos 0)&lt;br&gt;
             Wait: pump timer expires (pumpRunning → false)&lt;br&gt;
