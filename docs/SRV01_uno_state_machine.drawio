    <mxCell id="s_wait_home"
      value="&lt;b&gt;STATE_WAIT_DRUM_HOME&lt;/b&gt;&lt;br&gt;
             Wait: drum X physically fully retracted (targetX == 0)&lt;br&gt;
             → transitions to STATE_IDLE"
      style="rounded=1;whiteSpace=wrap;html=1;
             fillColor=#e1d5e7;strokeColor=#9673a6;
             align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
