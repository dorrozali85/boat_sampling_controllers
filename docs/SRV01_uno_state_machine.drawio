    ═══════════════════════════════════════════════════════ -->
    <mxCell id="4"
      value="&lt;b&gt;STATE_IDLE&lt;/b&gt;&lt;br&gt;
             Awaiting command via UART (from ESP32)&lt;br&gt;
             Accepts: :M1 (auto sample), :M2 (manual pump),&lt;br&gt;
             :B1, :D1, :E1, :F1, :Px, parameter commands"
      style="rounded=1;whiteSpace=wrap;html=1;
             fillColor=#ffe6cc;strokeColor=#d6b656;
             align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
      vertex="1" parent="1">
      <mxGeometry x="90" y="100" width="400" height="85" as="geometry" />
    </mxCell>

