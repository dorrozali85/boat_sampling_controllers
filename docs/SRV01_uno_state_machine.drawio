      vertex="1" parent="1">
      <mxGeometry x="90" y="1602" width="400" height="55" as="geometry" />
    </mxCell>

    <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;"
      edge="1" source="s_wait_home" target="s_x1" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- :X1 → IDLE loop-back (left side, x=40) -->
    <mxCell id="e_loop"
      value="→ STATE_IDLE"
      style="edgeStyle=orthogonalEdgeStyle;
             exitX=0;exitY=0.5;exitDx=0;exitDy=0;
             entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
      edge="1" source="s_x1" target="4" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="40" y="1629" />
          <mxPoint x="40" y="142"  />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════
         RIGHT PANEL — SERIAL COMMANDS
    ═══════════════════════════════════════════════════════ -->
    <mxCell id="r_cmds"
      value="&lt;b&gt;SERIAL COMMANDS (UART from ESP32)&lt;/b&gt;&lt;br&gt;&lt;br&gt;
             &lt;b&gt;Auto sample:&lt;/b&gt;&lt;br&gt;
             :M1 → start auto sample cycle&lt;br&gt;
             :M2 → start manual pump (continuous)&lt;br&gt;&lt;br&gt;
             &lt;b&gt;Manual positioning:&lt;/b&gt;&lt;br&gt;
             :B1 → retract drum to zero&lt;br&gt;
             :D1 → lower drum to sample depth&lt;br&gt;
             :E1 → lower drum 90°&lt;br&gt;
             :F1 → raise drum 90°&lt;br&gt;
             :Px → turntable to position x (0–5)&lt;br&gt;&lt;br&gt;
             &lt;b&gt;Runtime parameters (any time):&lt;/b&gt;&lt;br&gt;
             :SDx.x → set sample depth (0.0–2.0 m)&lt;br&gt;
             :FTxx → set flush time (0–60 s)&lt;br&gt;
             :BTxx → set fill time (0–60 s)&lt;br&gt;&lt;br&gt;
             &lt;b&gt;Emergency:&lt;/b&gt;&lt;br&gt;
             :C1 → stop all motion, reset to STATE_IDLE"
      style="rounded=1;whiteSpace=wrap;html=1;
             fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;
             align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
      vertex="1" parent="1">
      <mxGeometry x="700" y="100" width="320" height="385" as="geometry" />
    </mxCell>

    <!-- ═══ RIGHT PANEL — HARDWARE AXES ═══ -->
    <mxCell id="r_hw"
      value="&lt;b&gt;HARDWARE AXES (CNC Shield v3.0 — 1/16 microstepping)&lt;/b&gt;&lt;br&gt;&lt;br&gt;
             &lt;b&gt;X-axis — Drum (depth stepper)&lt;/b&gt;&lt;br&gt;
             NEMA17, 3200 steps/rev&lt;br&gt;
             Positive steps = down, Negative = up&lt;br&gt;
             ~0.1 m per revolution (~27825 steps/m)&lt;br&gt;&lt;br&gt;
             &lt;b&gt;Y-axis — Pump (peristaltic)&lt;/b&gt;&lt;br&gt;
             800 steps/rev, one direction only&lt;br&gt;
             Soft-start ramp: 300 µs → 80 µs step delay&lt;br&gt;&lt;br&gt;
             &lt;b&gt;Z-axis — Turntable (carousel)&lt;/b&gt;&lt;br&gt;
             3200 steps/rev, 6 positions × 60°&lt;br&gt;
             Position 0 = home / waste port&lt;br&gt;
             Positions 1–5 = sample bottles"
      style="rounded=1;whiteSpace=wrap;html=1;
             fillColor=#dae8fc;strokeColor=#6c8ebf;
             align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
      vertex="1" parent="1">
      <mxGeometry x="700" y="505" width="320" height="285" as="geometry" />
    </mxCell>

    <!-- ═══ RIGHT PANEL — EMERGENCY STOP ═══ -->
    <mxCell id="r_estop"
      value="&lt;b&gt;:C1 EMERGENCY STOP&lt;/b&gt;&lt;br&gt;
             Pump off; all steppers halted&lt;br&gt;
             (targetX = targetY = targetZ = 0)&lt;br&gt;
             sampleCount preserved&lt;br&gt;
             → STATE_IDLE immediately from any state"
      style="rounded=1;whiteSpace=wrap;html=1;
             fillColor=#f8cecc;strokeColor=#b85450;
             align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
      vertex="1" parent="1">
      <mxGeometry x="700" y="810" width="320" height="95" as="geometry" />
    </mxCell>

    <!-- Emergency stop → IDLE (dashed, routes through gap at x=600) -->
    <mxCell id="e_estop"
      value="any state → IDLE"
      style="edgeStyle=orthogonalEdgeStyle;dashed=1;
             exitX=0;exitY=0.5;exitDx=0;exitDy=0;
             entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
      edge="1" source="r_estop" target="4" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="600" y="857" />
          <mxPoint x="600" y="142" />
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- ═══ RIGHT PANEL — LEGEND ═══ -->
    <mxCell id="lbl_legend"
