    </mxCell>

    <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;"
      edge="1" source="s_turn_next" target="s_pre_sample" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- STATE_REAL_SAMPLE -->
    <mxCell id="s_real_sample"
      value="&lt;b&gt;STATE_REAL_SAMPLE&lt;/b&gt;&lt;br&gt;
             Run pump (fill mode) for configured fill time&lt;br&gt;
             Soft-start ramp; fills bottle N&lt;br&gt;
             Wait: pump timer expires (pumpRunning → false)&lt;br&gt;
             → transitions to STATE_POST_SAMPLE_SETTLE"
      style="rounded=1;whiteSpace=wrap;html=1;
             fillColor=#dae8fc;strokeColor=#6c8ebf;
             align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
      vertex="1" parent="1">
      <mxGeometry x="90" y="1162" width="400" height="90" as="geometry" />
    </mxCell>

    <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;"
      edge="1" source="s_pre_sample" target="s_real_sample" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- STATE_POST_SAMPLE_SETTLE -->
    <mxCell id="s_post_sample"
      value="&lt;b&gt;STATE_POST_SAMPLE_SETTLE&lt;/b&gt;&lt;br&gt;
             Wait: 5 s settle&lt;br&gt;
             sampleCount++ (bottle N now filled)&lt;br&gt;
             Issue: turntable Z → position 0 (home)&lt;br&gt;
             → transitions to STATE_TURN_HOME_FINAL"
      style="rounded=1;whiteSpace=wrap;html=1;
             fillColor=#d5e8d4;strokeColor=#82b366;
             align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
      vertex="1" parent="1">
      <mxGeometry x="90" y="1272" width="400" height="90" as="geometry" />
    </mxCell>

    <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;"
      edge="1" source="s_real_sample" target="s_post_sample" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ═══ SEPARATOR 3 ═══ -->
    <mxCell id="sep3" value=""
