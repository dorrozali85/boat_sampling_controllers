      <mxGeometry as="geometry">
        <mxPoint x="90"  y="1382" as="sourcePoint" />
        <mxPoint x="500" y="1382" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════
         PHASE 4 — RETURN
    ═══════════════════════════════════════════════════════ -->
    <mxCell id="lbl_ret"
