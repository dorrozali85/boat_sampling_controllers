      vertex="1" parent="1">
      <mxGeometry x="90" y="1384" width="200" height="18" as="geometry" />
    </mxCell>

    <!-- STATE_TURN_HOME_FINAL -->
    <mxCell id="s_turn_home_final"
      value="&lt;b&gt;STATE_TURN_HOME_FINAL&lt;/b&gt;&lt;br&gt;
             Wait: turntable Z physically at home (targetZ == 0)&lt;br&gt;
             Then issue: drum X retract fully to zero&lt;br&gt;
             → transitions to STATE_WAIT_DRUM_HOME"
      style="rounded=1;whiteSpace=wrap;html=1;
             fillColor=#e1d5e7;strokeColor=#9673a6;
             align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
      vertex="1" parent="1">
      <mxGeometry x="90" y="1407" width="400" height="85" as="geometry" />
