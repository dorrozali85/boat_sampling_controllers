      edge="1" parent="1">
      <mxGeometry as="geometry">
        <mxPoint x="30"   y="845" as="sourcePoint" />
        <mxPoint x="1280" y="845" as="targetPoint" />
      </mxGeometry>
    </mxCell>

    <!-- Sub-flow header labels -->
    <mxCell id="21"
      value="&lt;b&gt;STUCK RECOVERY — sequence detail&lt;/b&gt;"
      style="text;html=1;strokeColor=none;fillColor=none;
             align=left;verticalAlign=middle;whiteSpace=wrap;
             rounded=0;fontStyle=1;fontSize=12;"
      vertex="1" parent="1">
      <mxGeometry x="30" y="851" width="320" height="22" as="geometry" />
    </mxCell>

    <mxCell id="22"
      value="&lt;b&gt;WATER SAMPLING — sequence detail&lt;/b&gt;"
      style="text;html=1;strokeColor=none;fillColor=none;
             align=left;verticalAlign=middle;whiteSpace=wrap;
             rounded=0;fontStyle=1;fontSize=12;"
      vertex="1" parent="1">
      <mxGeometry x="465" y="851" width="320" height="22" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════
         STUCK RECOVERY — detail box
    ═══════════════════════════════════════════════════════ -->
    <mxCell id="23"
      value="&lt;b&gt;1. STOP&lt;/b&gt; — brief pause (~400 ms)&lt;br&gt;
             &lt;b&gt;2. REVERSE&lt;/b&gt; — motors reverse (~2 s); boat backs away&lt;br&gt;
             &lt;b&gt;3. STOP&lt;/b&gt; — brief pause (~400 ms)&lt;br&gt;
             &lt;b&gt;4. TURN&lt;/b&gt; — compass-controlled heading turn:&lt;br&gt;
             &amp;nbsp;&amp;nbsp;• Left switch → turn RIGHT (+30° to 90°)&lt;br&gt;
             &amp;nbsp;&amp;nbsp;• Right switch → turn LEFT (−30° to 90°)&lt;br&gt;
             &amp;nbsp;&amp;nbsp;• Front switch → turn RIGHT&lt;br&gt;
             &amp;nbsp;&amp;nbsp;Turn until |heading error| &lt; tolerance (or timeout)&lt;br&gt;
             &lt;b&gt;5. STOP&lt;/b&gt; — resume forward on new heading"
      style="rounded=1;whiteSpace=wrap;html=1;
             fillColor=#f8cecc;strokeColor=#b85450;
             align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
      vertex="1" parent="1">
      <mxGeometry x="30" y="881" width="425" height="200" as="geometry" />
    </mxCell>

    <!-- Stuck entry → detail -->
    <mxCell id="24"
      style="edgeStyle=orthogonalEdgeStyle;"
      edge="1" source="14" target="23" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════
         STUCK PAUSE NOTE
    ═══════════════════════════════════════════════════════ -->
    <mxCell id="25"
      value="⚠ Sample-interval countdown PAUSES for the full stuck duration.&lt;br&gt;
             Resumes from the same remaining value when stuck recovery exits."
      style="rounded=1;whiteSpace=wrap;html=1;
             fillColor=#fff2cc;strokeColor=#d6b656;"
      vertex="1" parent="1">
      <mxGeometry x="30" y="1098" width="425" height="60" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════
         WATER SAMPLING — detail box
    ═══════════════════════════════════════════════════════ -->
    <mxCell id="26"
      value="&lt;b&gt;1. REVERSE PHASE&lt;/b&gt;&lt;br&gt;
             &amp;nbsp;&amp;nbsp;Motors reverse ~7 s (kills forward momentum at sample point)&lt;br&gt;&lt;br&gt;
             &lt;b&gt;2. SAMPLE WAIT&lt;/b&gt;&lt;br&gt;
             &amp;nbsp;&amp;nbsp;&lt;i&gt;Arduino present:&lt;/i&gt; send :M1 command;&lt;br&gt;
             &amp;nbsp;&amp;nbsp;Arduino executes: lower drum → flush hose&lt;br&gt;
             &amp;nbsp;&amp;nbsp;→ rotate turntable → fill bottle → retract drum;&lt;br&gt;
             &amp;nbsp;&amp;nbsp;replies :X1 when done&lt;br&gt;
             &amp;nbsp;&amp;nbsp;&lt;i&gt;No Arduino:&lt;/i&gt; self-acknowledge after configurable delay&lt;br&gt;&lt;br&gt;
             &lt;b&gt;3. ALIGN PHASE&lt;/b&gt;&lt;br&gt;
             &amp;nbsp;&amp;nbsp;Closed-loop compass turn back to HDG₀&lt;br&gt;
             &amp;nbsp;&amp;nbsp;(boat may drift during ~136 s sample wait)&lt;br&gt;
             &amp;nbsp;&amp;nbsp;Wait until |heading error| &lt; tolerance&lt;br&gt;&lt;br&gt;
             &lt;b&gt;4. RESUME FORWARD&lt;/b&gt; on locked heading"
      style="rounded=1;whiteSpace=wrap;html=1;
             fillColor=#e1d5e7;strokeColor=#9673a6;
             align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
      vertex="1" parent="1">
      <mxGeometry x="465" y="881" width="455" height="300" as="geometry" />
    </mxCell>

    <!-- Sampling entry → detail -->
    <mxCell id="27"
      style="edgeStyle=orthogonalEdgeStyle;"
      edge="1" source="16" target="26" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ═══════════════════════════════════════════════════════
         STOP BUTTON NOTE
    ═══════════════════════════════════════════════════════ -->
    <mxCell id="28"
      value="&lt;b&gt;STOP button&lt;/b&gt; (always visible in GUI top bar)
             → Returns to STOP MODE from ANY state at ANY time"
      style="rounded=1;whiteSpace=wrap;html=1;
             fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;"
      vertex="1" parent="1">
      <mxGeometry x="260" y="1228" width="420" height="60" as="geometry" />
